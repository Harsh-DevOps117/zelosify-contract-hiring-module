# Required: real Groq API key for the recommendation worker.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.8-27b
HIRING_WORKER_CONCURRENCY=4

# Optional: existing hiring manager's database user ID to own the demo openings.
HIRING_SEED_MANAGER_ID=


# Local development defaults only. Keep this stack bound to localhost.
# Use URL-safe characters for POSTGRES_PASSWORD (it is embedded in DATABASE_URL).
POSTGRES_PASSWORD=local-postgres
KEYCLOAK_ADMIN_PASSWORD=local-admin
KEYCLOAK_CLIENT_SECRET=local-client-secret
JWT_SECRET=local-jwt-secret-change-before-deployment
SESSION_SECRET=local-session-secret-change-before-deployment
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
HIRING_UPLOAD_SIGNING_SECRET=local-upload-secret-change-before-deployment
